meta {
  name: 05 Reset Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "resetToken": "{{resetToken}}",
    "newPassword": "NuevaClave123!"
  }
}

docs {
  Restablece la contraseña usando el `resetToken` capturado en Forgot Password.
  `newPassword` debe cumplir las reglas de complejidad (>=8, mayúscula, dígito/símbolo).
}
