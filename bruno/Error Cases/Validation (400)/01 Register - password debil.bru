meta {
  name: 01 Register - password debil
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Test",
    "lastName": "User",
    "email": "no-es-un-email",
    "password": "corta"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("rechaza con 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("devuelve detalle de campos invalidos", function () {
    const body = res.getBody();
    expect(body).to.have.property("errors");
    expect(body.errors).to.be.an("array");
  });
}

docs {
  Validación (400). Email con formato inválido y contraseña que no cumple las
  reglas de complejidad. El backend responde con `{ status, message, errors }`.
}
