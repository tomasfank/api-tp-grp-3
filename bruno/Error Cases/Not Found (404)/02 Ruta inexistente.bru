meta {
  name: 02 Ruta inexistente
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/no-existe
  body: none
  auth: none
}

assert {
  res.status: eq 404
}

tests {
  test("rechaza con 404", function () {
    expect(res.getStatus()).to.equal(404);
  });
}

docs {
  No encontrado (404). Ruta no registrada — la maneja el notFoundHandler.
}
