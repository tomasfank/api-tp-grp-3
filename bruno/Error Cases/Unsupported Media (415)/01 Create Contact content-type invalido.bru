meta {
  name: 01 Create Contact content-type invalido
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/contacts
  body: text
  auth: none
}

headers {
  Content-Type: text/plain
}

body:text {
  name=Juan&subject=Hola
}

assert {
  res.status: eq 415
}

tests {
  test("rechaza con 415", function () {
    expect(res.getStatus()).to.equal(415);
  });
}

docs {
  Media no soportada (415). Ruta mutante (POST) con Content-Type distinto de
  application/json. El backend rechaza antes de parsear el body.
}
