meta {
  name: 02 Create Category token invalido
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/categories
  body: json
  auth: none
}

headers {
  Authorization: Bearer token-falso-invalido
}

body:json {
  {
    "name": "Deberia fallar"
  }
}

assert {
  res.status: eq 401
}

tests {
  test("rechaza con 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Autenticación (401). Token con firma inválida. Responde "Token inválido o expirado".
}
