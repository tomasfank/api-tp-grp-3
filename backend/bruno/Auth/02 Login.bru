meta {
  name: 02 Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  // Guarda el JWT devuelto para reutilizarlo en endpoints protegidos
  if (res.status === 200 && res.body && res.body.token) {
    bru.setEnvVar("token", res.body.token);
    console.log("Token guardado en la variable de entorno 'token'.");
  }
}

tests {
  test("login responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("devuelve un token", function () {
    expect(res.getBody()).to.have.property("token");
  });
}

docs {
  Autentica con email y contraseña. Responde 200 con `{ "token": "<jwt>" }`.
  El script post-response guarda ese token en la variable de entorno `token`,
  que luego usan automáticamente todos los endpoints protegidos.
}
