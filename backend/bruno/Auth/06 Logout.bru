meta {
  name: 06 Logout
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

script:post-response {
  // Limpia el token local tras cerrar sesión
  if (res.status === 200) {
    bru.setEnvVar("token", "");
  }
}

docs {
  [auth] Invalida el JWT enviado en el header Authorization (lo agrega a la
  blacklist). Tras un logout exitoso, se limpia la variable `token`.
}
