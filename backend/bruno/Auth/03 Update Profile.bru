meta {
  name: 03 Update Profile
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/auth/profile
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Admin Actualizado",
    "lastName": "Vaultra",
    "phone": "1199887766"
  }
}

docs {
  [auth, admin] Actualiza el perfil del admin autenticado. Debe enviarse al
  menos un campo (`name`, `lastName` o `phone`). Usa el token capturado en Login.
}
