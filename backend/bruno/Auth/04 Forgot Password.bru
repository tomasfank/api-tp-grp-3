meta {
  name: 04 Forgot Password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}"
  }
}

script:post-response {
  // Captura el resetToken para encadenar con Reset Password
  if (res.body && res.body.resetToken) {
    bru.setEnvVar("resetToken", res.body.resetToken);
  }
}

docs {
  Genera un token de restablecimiento de contraseña. Siempre responde igual,
  exista o no el email. El `resetToken` devuelto se guarda para el siguiente request.
}
