meta {
  name: 03 Update Category
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/categories/{{categoryId}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Cloud & DevOps"
  }
}

docs {
  [admin] Actualiza el nombre de la categoría `{{categoryId}}`.
}
