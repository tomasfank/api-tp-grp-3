meta {
  name: 01 Register email duplicado
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Admin",
    "lastName": "Vaultra",
    "email": "{{adminEmail}}",
    "password": "Admin1234!",
    "phone": "1122334455"
  }
}

assert {
  res.status: eq 409
}

tests {
  test("rechaza con 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
}

docs {
  Conflicto (409). Reintentar el registro con un email ya existente. Ejecutá
  primero `Auth > 01 Register` con el mismo email para provocar el conflicto.
  El backend responde "El correo electrónico ya está en uso".
}
