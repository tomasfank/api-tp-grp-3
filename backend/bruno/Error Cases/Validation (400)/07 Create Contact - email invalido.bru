meta {
  name: 07 Create Contact - email invalido
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/contacts
  body: json
  auth: none
}

body:json {
  {
    "name": "Juan",
    "email": "correo-invalido",
    "subject": "",
    "message": ""
  }
}

assert {
  res.status: eq 400
}

tests {
  test("rechaza con 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  Validación (400). Email con formato inválido y asunto/mensaje vacíos.
}
