meta {
  name: 01 Create Category como no-admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/categories
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{nonAdminToken}}
}

body:json {
  {
    "name": "Categoria prohibida"
  }
}

assert {
  res.status: eq 403
}

tests {
  test("rechaza con 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}

docs {
  Autorización (403). Token válido pero de un usuario SIN rol admin.

  Requiere la variable `nonAdminToken` con un JWT de un usuario con rol distinto
  de `admin`. El backend responde "Permisos insuficientes".
}
