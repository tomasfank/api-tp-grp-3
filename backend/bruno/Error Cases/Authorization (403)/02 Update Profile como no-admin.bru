meta {
  name: 02 Update Profile como no-admin
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/auth/profile
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{nonAdminToken}}
}

body:json {
  {
    "name": "Intento no-admin"
  }
}

assert {
  res.status: eq 403
}

tests {
  test("rechaza con 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}

docs {
  Autorización (403). El endpoint de perfil exige rol admin. Con un token
  no-admin debe rechazar con 403. Requiere `nonAdminToken`.
}
