meta {
  name: 02 Update Contact Status
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/admin/contacts/{{contactId}}/status
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "status": "read"
  }
}

docs {
  [admin] Cambia el estado del contacto `{{contactId}}` a `pending`, `read` o `answered`.
}
